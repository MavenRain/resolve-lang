def sigTampered : Flag := sigOk b1j0c1x b1j0c1y b0j0c2x b0j0c2y b0j1c1x b0j1c1y b0j1c2x b0j1c2y b0c1 b0s1 b0s2 b0s3 b0ix b0iy
def tallyOpenLeft : Flag := openSum (sum3 (pair b0j0c1x b0j0c1y) (pair b1j0c1x b1j0c1y) (pair b2j0c1x b2j0c1y)) (sum3 (pair b0j0c2x b0j0c2y) (pair b1j0c2x b1j0c2y) (pair b2j0c2x b2j0c2y)) tlc1x tlc1y tlc2x tlc2y tld1x tld1y tla1x tla1y tlb1x tlb1y tlz1 tld2x tld2y tla2x tla2y tlb2x tlb2y tlz2 1u
def tallyOpenRight : Flag := openSum (sum3 (pair b0j1c1x b0j1c1y) (pair b1j1c1x b1j1c1y) (pair b2j1c1x b2j1c1y)) (sum3 (pair b0j1c2x b0j1c2y) (pair b1j1c2x b1j1c2y) (pair b2j1c2x b2j1c2y)) trc1x trc1y trc2x trc2y trd1x trd1y tra1x tra1y trb1x trb1y trz1 trd2x trd2y tra2x tra2y trb2x trb2y trz2 2u
-- Opening regressions: scalar reduction must not inflate the vote counts.
def openZero : Flag := opens 0u 0u 0u 0u 0u
def openLastScalar : Flag := opens (first negG) (second negG) 0u 0u (u256Sub frR 1u)
def openOrder : Flag := opens 0u 0u 0u 0u frR
def openAlias : Flag := opens tlc2x tlc2y tlkx tlky (u256Add frR 1u)
def tallyOpenLeftAlias : Flag := openSum (sum3 (pair b0j0c1x b0j0c1y) (pair b1j0c1x b1j0c1y) (pair b2j0c1x b2j0c1y)) (sum3 (pair b0j0c2x b0j0c2y) (pair b1j0c2x b1j0c2y) (pair b2j0c2x b2j0c2y)) tlc1x tlc1y tlc2x tlc2y tld1x tld1y tla1x tla1y tlb1x tlb1y tlz1 tld2x tld2y tla2x tla2y tlb2x tlb2y tlz2 (u256Add frR 1u)

-- The key image of voter 0 is the key image of examples/ring.lang (sigA,
-- market 0): a kit signature with the same tweaked key in the same dispute
-- gives the same I. The key image of a signature is its last two words.
def wordCount : List U256 -> U256 := fun (w : List U256) => fold (fun (x : U256) (n : U256) => u256Add n 1u) 0u w
def noWords : List U256 := nil
def lastTwo : List U256 -> List U256 := fun (w : List U256) =>
  fold (fun (x : U256) (acc : List U256) => flagIf (u256Le 2u (wordCount acc)) acc (cons x acc)) noWords w
def keyImage : List U256 -> U256 := fun (w : List U256) => fold (fun (x : U256) (h : U256) => hash x h) 0u (lastTwo w)
def sigRef : List U256 :=
  zkSign (cons (tweaked disputeId (ecMul gen (zkKey 0))) (cons (tweaked disputeId (ecMul gen (zkKey 1))) nil)) (shift (zkKey 0) (tweakOf disputeId)) disputeId 1u
def imageGood : Flag := u256Eq (keyImage sigRef) (keyImage (cons b0ix (cons b0iy nil)))

-- The majority on the opened counts (Q-S6-3 (a)): right (1) only when the
-- left count is below the right count, so a tie keeps left (0).
def verdictWord : U256 -> U256 -> U256 := fun (l r : U256) => flagIf (u256Le r l) 0u 1u
def verdict : (env : Env) -> (s : State) -> (l r : U256) -> U256 :=
  fun (env : Env) (s : State) (l r : U256) => verdictWord l r
def verdictOpened : U256 := verdictWord 1u 2u
def verdictTie : U256 := verdictWord 1u 1u
