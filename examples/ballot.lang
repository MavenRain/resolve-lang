-- The dispute ballots on the chain (resolve-lang S6 s2, PLAN 4.4), a port of
-- intent-lang 3df9d96 examples/ballot.lang (Q-S6-2 (a)). A kit file: word
-- literals and word ops are kit items. Each constant comes from the host
-- (`build/ballottool words`: the election key PK of thresholdtool (n 3, t 2),
-- the charter keys blsag_key(0 .. 2) G before the tweak, and voters 0, 1 and
-- 2 vote right, right and left; k 2, left is slot 0). The dispute id of
-- market 0 replaces the poll 0 of intent-lang, and the ring is the tweaked
-- ring of examples/ring.lang, so the key image of a voter is the key image of
-- ring.lang (imageGood). ctxOf is the hash chain from ballotTag ("ballot")
-- over the key image I and the dispute id, and slotBound and sumBound check
-- the proofs of onehot.lang under it, so a ballot copied under a second key
-- image fails them. ballotSig checks the ring signature over the hash chain
-- from digestTag ("digest") over the 8 slot ciphertext words, so a changed
-- slot fails it. PK is a contract constant. The opening views are those of
-- threshold.lang on the summed slots, and verdict is the majority on the
-- opened counts (Q-S6-3 (a)). The ballot entry, the encrypted tally in the
-- state and openTally are S7 (Q-S6-5 (a)).
state State := makeState (cast : Nat)

def init : State := makeState 0

def ballotTag : U256 := 0x62616c6c6f74u

def digestTag : U256 := 0x646967657374u

def randTag : U256 := 0x72616e64u

def onehotTag : U256 := 0x6f6e65686f74u

def dleqTag : U256 := 1684825457u

-- The dispute of market 0 in the deployment of examples/ring.lang: the
-- dispute id d replaces the poll, and the ring is K_i + t G with
-- t = hash(1, d) mod r.
def frR : U256 := 21888242871839275222246405745257275088548364400416034343698204186575808495617u
def reduceOnce : U256 -> U256 := fun (x : U256) => flagIf (u256Le frR x) (u256Sub x frR) x
def modR : U256 -> U256 := fun (x : U256) => reduceOnce (reduceOnce (reduceOnce (reduceOnce (reduceOnce x))))
def shift : U256 -> U256 -> U256 := fun (x : U256) (t : U256) => reduceOnce (u256Add x t)
def deployment : U256 := hash 1u (addrToU256 0x00000000000000000000000000000000000000c1)
def disputeOf : U256 -> U256 := fun (m : U256) => hash deployment m
def tweakOf : U256 -> U256 := fun (d : U256) => modR (hash 1u d)
def tweaked : U256 -> Prod U256 U256 -> Prod U256 U256 :=
  fun (d : U256) (p : Prod U256 U256) => ecAdd p (ecMul (pair 1u 2u) (tweakOf d))
def disputeId : U256 := disputeOf 0u

